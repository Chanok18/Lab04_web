<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Manchester United - Plantilla</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <style>
    body {
      background-color: #faf8f8;
      color: #fff;
    }
    .navbar-united {
      background-color: #DA020E;
    }
    .header-section {
      text-align: center;
      padding: 30px 0 10px 0;
    }
    .header-section img {
      width: 110px;
      margin-bottom: 10px;
    }
    h3, h5 {
      color: #DA020E;
      font-weight: bold;
    }
    .card-panel-united {
      background-color: #faf6f6;
      border-left: 5px solid #141413;
    }
    .btn-united {
      background-color: #DA020E !important;
    }
    .btn-united:hover {
      background-color: #a5010a !important;
    }
    table.striped {
      background-color: #fff;
      color: #1a1a1a;
      border-radius: 5px;
      overflow: hidden;
    }
    thead {
      background-color: #DA020E;
    }
    thead th {
      color: #fff !important;
    }
    .input-field label {
      color: #000000 !important;
    }
    .input-field input:focus + label,
    .input-field textarea:focus + label {
      color: #000000 !important;
    }
    .input-field input:focus,
    .input-field textarea:focus {
      border-bottom: 1px solid #030303 !important;
      box-shadow: 0 1px 0 0 #000000 !important;
    }
    footer.page-footer {
      background-color: #000;
    }
  </style>
</head>
<body>

  <nav class="navbar-united">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo">
        <i class="material-icons left">sports_soccer</i>Manchester United
      </a>
      <ul class="right hide-on-med-and-down">
        <li><a href="/">Inicio</a></li>
        <li><a href="/players">Plantilla</a></li>
      </ul>
    </div>
  </nav>

  <div class="header-section">
    <img src="/images/escudo.png" alt="Escudo Manchester United">
    <h3>Plantilla del Manchester United</h3>
    <p style="color: #0e0e0d;">Old Trafford — Theatre of Dreams</p>
  </div>

  <div class="container" style="margin-top: 20px;">

    <div class="card-panel card-panel-united">
      <h5><i class="material-icons left">person_add</i>Agregar Jugador</h5>
      <form action="/players" method="POST" class="col s12">
        <div class="row">
          <div class="input-field col s12 m6">
            <input id="nombre" type="text" name="nombre" required>
            <label for="nombre">Nombre del jugador</label>
          </div>
          <div class="input-field col s12 m6">
            <input id="posicion" type="text" name="posicion" required>
            <label for="posicion">Posición</label>
          </div>
          <div class="input-field col s12 m4">
            <input id="dorsal" type="number" name="dorsal" required>
            <label for="dorsal">Número de camiseta</label>
          </div>
          <div class="input-field col s12 m4">
            <input id="nacionalidad" type="text" name="nacionalidad" required>
            <label for="nacionalidad">Nacionalidad</label>
          </div>
          <div class="input-field col s12 m4">
            <input id="goles" type="number" name="goles" required>
            <label for="goles">Goles esta temporada</label>
          </div>
        </div>
        <button type="submit" class="waves-effect waves-light btn btn-united">
          <i class="material-icons left">add</i>Agregar Jugador
        </button>
        <a href="/" class="waves-effect waves-light btn grey">Volver</a>
      </form>
    </div>

    <h5><i class="material-icons left">groups</i>Jugadores registrados</h5>
    <table class="striped">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Posición</th>
          <th>Dorsal</th>
          <th>Nacionalidad</th>
          <th>Goles</th>
        </tr>
      </thead>
      <tbody>
        <% if (players.length === 0) { %>
          <tr><td colspan="5" class="center-align">Aún no hay jugadores registrados.</td></tr>
        <% } else { %>
          <% players.forEach(p => { %>
            <tr>
              <td><%= p.nombre %></td>
              <td><%= p.posicion %></td>
              <td><span class="new badge red" data-badge-caption=""><%= p.dorsal %></span></td>
              <td><%= p.nacionalidad %></td>
              <td><%= p.goles %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>

  </div>

  <footer class="page-footer" style="margin-top: 40px;">
    <div class="footer-copyright center-align" style="background-color:#000;">
      <p style="color: #e9e8e0;">  Man United</p>
    </div>
  </footer>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>